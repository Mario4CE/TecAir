<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
          x:Class="TecAir.Views.PromotionsPage"
          Title="Promociones"
          BackgroundColor="#F5F5F5">

    
    <Grid Padding="15"
      RowDefinitions="Auto,*">

        <!-- Título -->
        <Label Grid.Row="0"
           Text="🎉 Promociones Especiales"
           FontAttributes="Bold"
           FontSize="20"
           Margin="0,10"
           TextColor="#1E293B"/>

        <!-- Lista de promociones -->
        <CollectionView Grid.Row="1"
                    x:Name="PromotionsCollectionView"
                    ItemsSource="{Binding Promotions}"
                    EmptyView="No hay promociones disponibles">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                               ItemSpacing="10"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame BorderColor="#FF9500"
                       CornerRadius="12"
                       HasShadow="True"
                       Padding="15"
                       BackgroundColor="White"
                       Margin="0,5">

                        <VerticalStackLayout Spacing="10">

                            <!-- Debug temporal -->
                            <Label Text="{Binding ApiId}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="Red"/>

                            <!-- Imagen -->
                            <Image Source="{Binding ImageUrl}"
                               Aspect="AspectFill"
                               HeightRequest="150"/>

                            <!-- Descripción -->
                            <Label Text="{Binding Description}"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#1E293B"/>

                            <Grid ColumnDefinitions="*,Auto">

                                <!-- Ruta -->
                                <VerticalStackLayout Grid.Column="0"
                                                 Spacing="2">

                                    <Label Text="Ruta"
                                       FontSize="11"
                                       TextColor="#64748B"/>

                                    <Label Text="{Binding OriginAirportId, StringFormat='Ruta: {0}'}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"/>

                                </VerticalStackLayout>

                                <!-- Precio -->
                                <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2">

                                    <Label Text="Precio Especial"
                                       FontSize="11"
                                       HorizontalTextAlignment="End"
                                       TextColor="#64748B"/>

                                    <Label Text="{Binding PromotionalPrice, StringFormat='${0:F2}'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End"
                                       TextColor="#FF9500"/>

                                </VerticalStackLayout>

                            </Grid>

                            <!-- Fecha de vigencia -->
                            <Label Text="{Binding EndDate, StringFormat='Vigencia hasta: {0:dd/MM/yyyy}'}"
                               FontSize="11"
                               TextColor="#64748B"/>

                            <!-- Botón -->
                            <Button Text="Reservar Ahora"
                                FontSize="14"
                                FontAttributes="Bold"
                                Padding="12"
                                CornerRadius="8"
                                BackgroundColor="#FF9500"
                                TextColor="White"
                                Margin="0,8,0,0"
                                Clicked="OnBookPromoClicked"/>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
   

</ContentPage>
