<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TecAir.Views.PromotionsPage"
             Title="Promociones"
             BackgroundColor="#F5F5F5">

    <VerticalStackLayout Padding="15" Spacing="10">
        
        <Label Text="🎉 Promociones Especiales" FontAttributes="Bold" FontSize="16" Margin="0,10" TextColor="Black"/>
        
        <CollectionView 
            x:Name="PromotionsCollectionView"
           
            EmptyView="No hay promociones disponibles">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="#FF9500" CornerRadius="10" HasShadow="False" Padding="15" BackgroundColor="Black">
                        <VerticalStackLayout Spacing="8">
                            <!-- Imagen de promoción (si existe) -->
                            <Image 
                                Source="{Binding ImageUrl}" 
                                Aspect="AspectFill" 
                                HeightRequest="150"
                                IsVisible="{Binding ImageUrl, Converter={StaticResource StringToBoolConverter}}"/>
                            
                            <Label Text="{Binding Description}" FontAttributes="Bold" FontSize="14" TextColor="Black"/>
                            
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="FillAndExpand">
                                    <Label Text="Origen → Destino" FontSize="11" TextColor="Black"/>
                                    <Label Text="{Binding OriginAirportId, StringFormat='Ruta: {0}'}" FontSize="12" FontAttributes="Bold" TextColor="Black"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Precio Especial" FontSize="11" TextColor="Black"/>
                                    <Label Text="{Binding PromotionalPrice, StringFormat='${0:F2}'}" FontSize="14" TextColor="Black" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </StackLayout>

                            <Label 
                                Text="{Binding EndDate, StringFormat='Vigencia hasta: {0:dd/MM/yyyy}'}" 
                                FontSize="10" 
                                TextColor="Black"/>

                            <Button 
                                Text="Reservar Ahora"
                                FontSize="13"
                                Padding="12"
                                CornerRadius="6"
                                BackgroundColor="#FF9500"
                                TextColor="Black"
                                Margin="0,8,0,0"
                                Clicked="OnBookPromoClicked"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>
