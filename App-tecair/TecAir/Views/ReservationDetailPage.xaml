<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TecAir.Views.ReservationDetailPage"
             Title="Reservar Vuelo"
             BackgroundColor="#F5F5F5">
    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="10">

            <!-- Detalles del Vuelo -->
            <Frame BorderColor="#E0E0E0" CornerRadius="10" HasShadow="False" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Detalles del Vuelo" FontAttributes="Bold" FontSize="14" TextColor="Black"/>

                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding OriginAirport.Code}" FontAttributes="Bold" FontSize="16" TextColor="#007AFF"/>
                            <Label Text="{Binding OriginAirport.City}" FontSize="11" TextColor="#666666"/>
                        </VerticalStackLayout>
                        <Label Text="✈️" FontSize="24" VerticalOptions="Center" HorizontalOptions="CenterAndExpand"/>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="End">
                            <Label Text="{Binding DestinationAirport.Code}" FontAttributes="Bold" FontSize="16" TextColor="#007AFF"/>
                            <Label Text="{Binding DestinationAirport.City}" FontSize="11" TextColor="#666666"/>
                        </VerticalStackLayout>
                    </StackLayout>

                    <BoxView Color="#E0E0E0" HeightRequest="1"/>

                    <StackLayout Orientation="Horizontal" Spacing="15">
                        <VerticalStackLayout>
                            <Label Text="Vuelo:" FontSize="11" TextColor="#666666"/>
                            <Label Text="{Binding SelectedFlight.FlightNumber}" FontSize="12" TextColor="Black"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="Fecha:" FontSize="11" TextColor="#666666"/>
                            <Label Text="{Binding SelectedFlight.DepartureTime, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="12" TextColor="Black"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="Precio Base:" FontSize="11" TextColor="#666666"/>
                            <Label Text="{Binding BaseCost, StringFormat='${0:F2}'}" FontSize="12" FontAttributes="Bold" TextColor="#34C759"/>
                        </VerticalStackLayout>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Selección de Asiento -->
            <Frame BorderColor="#E0E0E0" CornerRadius="10" HasShadow="False" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Selecciona tus Asientos:" FontAttributes="Bold" FontSize="12" TextColor="Black"/>

                    <Label x:Name="SelectedSeatLabel" 
                       Text="Asientos no seleccionados"
                       FontSize="11" 
                       TextColor="#666666"
                       FontAttributes="Italic"/>

                    <Grid x:Name="SeatGrid"
                      ColumnDefinitions="*,*,*,*,*,*" 
                      RowDefinitions="*,*,*,*,*,*,*,*" 
                      ColumnSpacing="5" 
                      RowSpacing="5">
                        <!-- Asientos generados dinámicamente -->
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Selección de Maletas -->
            <Frame BorderColor="#E0E0E0" CornerRadius="10" HasShadow="False" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Maletas (Primera gratis, $50 segunda, $75 restantes):" 
                       FontAttributes="Bold" 
                       FontSize="12" 
                       TextColor="Black"/>

                    <StackLayout Orientation="Horizontal" Spacing="10" Margin="0,5">
                        <Button Text="−" 
                            Clicked="OnDecreaseLuggageClicked"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="5"
                            CornerRadius="6"
                            BackgroundColor="#FF3B30"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"/>

                        <Label x:Name="LuggageCountLabel"
                           Text="{Binding LuggageCount}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#007AFF"
                           HorizontalOptions="CenterAndExpand"
                           VerticalOptions="Center"/>

                        <Button Text="+" 
                            Clicked="OnIncreaseLuggageClicked"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="5"
                            CornerRadius="6"
                            BackgroundColor="#34C759"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"/>
                    </StackLayout>

                    <BoxView Color="#E0E0E0" HeightRequest="1"/>

                    <StackLayout Orientation="Horizontal">
                        <Label Text="Costo de Maletas:" FontSize="12" TextColor="#666666"/>
                        <Label Text="{Binding LuggageCost, StringFormat='${0:F2}'}" 
                           FontSize="12" 
                           FontAttributes="Bold"
                           TextColor="#FF3B30"
                           HorizontalOptions="EndAndExpand"/>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Resumen de Costos -->
            <Frame BorderColor="#007AFF" CornerRadius="10" HasShadow="False" Padding="15">
                <VerticalStackLayout Spacing="8">
                    <StackLayout Orientation="Horizontal">
                        <Label Text="Asientos:" FontSize="12" TextColor="Black"/>
                        <Label Text="{Binding SelectedSeatsCount, StringFormat='{0} × '}" 
                           FontSize="12"
                           TextColor="Black"/>
                        <Label Text="{Binding BaseCost, StringFormat='${0:F2} ='}" 
                           FontSize="12"
                           TextColor="Black"/>
                        <Label Text="{Binding TotalCost, StringFormat=' ${0:F2}'}" 
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#34C759"
                           HorizontalOptions="EndAndExpand"/>
                    </StackLayout>

                    <StackLayout Orientation="Horizontal">
                        <Label Text="Maletas:" FontSize="12" TextColor="Black"/>
                        <Label Text="{Binding LuggageCost, StringFormat='${0:F2}'}" 
                           FontSize="12"
                           TextColor="Black"
                           HorizontalOptions="EndAndExpand"/>
                    </StackLayout>

                    <BoxView Color="#E0E0E0" HeightRequest="1"/>

                    <StackLayout Orientation="Horizontal">
                        <Label Text="TOTAL:" FontSize="14" FontAttributes="Bold" TextColor="#007AFF"/>
                        <Label Text="{Binding TotalCost, StringFormat='${0:F2}'}" 
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#007AFF"
                           HorizontalOptions="EndAndExpand"/>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Datos de Pago -->
            <Frame BorderColor="#E0E0E0" CornerRadius="10" HasShadow="False" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Información de Pago" FontAttributes="Bold" FontSize="12" TextColor="Black"/>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Número de Tarjeta:" FontSize="11" TextColor="Black"/>
                        <Entry x:Name="CardNumberEntry"
                           Placeholder="1234 5678 9012 3456"
                           Keyboard="Numeric"
                           TextColor="Black"
                           PlaceholderColor="#CCCCCC"/>
                    </VerticalStackLayout>

                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <VerticalStackLayout Spacing="5" HorizontalOptions="FillAndExpand">
                            <Label Text="Expiración:" FontSize="11" TextColor="Black"/>
                            <Entry x:Name="ExpirationEntry"
                               Placeholder="MM/YY"
                               TextColor="Black"
                               PlaceholderColor="#CCCCCC"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5" HorizontalOptions="FillAndExpand">
                            <Label Text="CVV:" FontSize="11" TextColor="Black"/>
                            <Entry x:Name="CVVEntry"
                               Placeholder="123"
                               Keyboard="Numeric"
                               IsPassword="True"
                               TextColor="Black"
                               PlaceholderColor="#CCCCCC"/>
                        </VerticalStackLayout>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Botón de Confirmar Reserva -->
            <Button x:Name="ConfirmBtn"
                Text="💳 Confirmar y Pagar"
                FontSize="14"
                FontAttributes="Bold"
                Padding="15"
                CornerRadius="10"
                BackgroundColor="#007AFF"
                TextColor="White"
                Margin="0,10"
                Clicked="OnConfirmReservationClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
