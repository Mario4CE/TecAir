<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TecAir.Views.FlightsSearchPage"
             Title="Búsqueda de Vuelos"
             BackgroundColor="#F5F5F5">

    <VerticalStackLayout Padding="15" Spacing="15">
        
        <!-- Filtros de búsqueda -->
        <Frame BorderColor="#E0E0E0" CornerRadius="10" HasShadow="False" Padding="15">
            <VerticalStackLayout Spacing="10">
                
                <Label Text="Origen:" FontAttributes="Bold" FontSize="12" TextColor="Black"/>
                <Picker 
                    x:Name="OriginPicker"
                    Title="Selecciona aeropuerto"
                    TextColor="#333333"
                    TitleColor="#999999"/>

                <Label Text="Destino:" FontAttributes="Bold" FontSize="12" Margin="0,10,0,0" TextColor="Black"/>
                <Picker 
                    x:Name="DestinationPicker"
                    Title="Selecciona aeropuerto"
                    TextColor="#333333"
                    TitleColor="#999999"/>

                <Label Text="Fecha:" FontAttributes="Bold" FontSize="12" Margin="0,10,0,0" TextColor="Black"/>
                <DatePicker 
                    x:Name="DatePicker"
                    Format="dd/MM/yyyy"
                    TextColor="Black"/>

                <Button 
                    x:Name="SearchBtn"
                    Text="🔍 Buscar Vuelos"
                    FontSize="14"
                    FontAttributes="Bold"
                    Padding="15"
                    CornerRadius="8"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    Margin="0,10,0,0"
                    Clicked="OnSearchClicked"/>
            </VerticalStackLayout>
        </Frame>

        <!-- Lista de vuelos -->
        <Label Text="Vuelos Disponibles:" FontAttributes="Bold" FontSize="14" Margin="0,10" TextColor="Black"/>
        
        <CollectionView 
            x:Name="FlightsCollectionView"
            SelectionMode="Single"
            SelectionChangedCommand="{Binding SelectFlightCommand}"
            SelectionChangedCommandParameter="{Binding SelectionChangedEventArgs.CurrentSelection, Source={x:Reference FlightsCollectionView}}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="#E0E0E0" CornerRadius="10" HasShadow="False" Padding="15">
                        <VerticalStackLayout Spacing="8">
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Label Text="✈️" FontSize="20"/>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding FlightNumber}" FontAttributes="Bold" FontSize="14"/>
                                    <Label Text="{Binding DepartureTime, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="12" TextColor="#666666"/>
                                </VerticalStackLayout>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Label Text="Asientos disponibles:" FontSize="11" TextColor="#666666"/>
                                <Label Text="{Binding AvailableSeats}" FontSize="11" TextColor="#007AFF" FontAttributes="Bold"/>
                            </StackLayout>
                            <Button 
                                Text="Reservar"
                                FontSize="12"
                                Padding="10"
                                CornerRadius="6"
                                BackgroundColor="#34C759"
                                TextColor="White"
                                Margin="0,5,0,0"
                                Clicked="OnReserveClicked"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>
